<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WSA.App</RootNamespace>
    <AssemblyName>WSA</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>en-US</DefaultLanguage>

    <!-- Deployment model: UNPACKAGED + self-contained Windows App SDK + self-contained .NET.
         The output folder runs on a clean Windows 10 1809+/11 x64 machine without installing the .NET or
         Windows App SDK runtimes. This is what the ZIP artifact contains. It is NOT an MSIX. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- CommunityToolkit.Mvvm: field-based [ObservableProperty] is used deliberately. -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WSA.Core\WSA.Core.csproj" />
    <ProjectReference Include="..\WSA.Infrastructure\WSA.Infrastructure.csproj" />
  </ItemGroup>
</Project>
