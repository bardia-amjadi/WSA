<Window
    x:Class="WSA.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView
        x:Name="Nav"
        PaneDisplayMode="Left"
        OpenPaneLength="232"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="Nav_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Overview" Tag="overview" Icon="Home" />
            <NavigationViewItem Content="Virtual Devices" Tag="devices">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8EA;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Phone" Tag="phone" Icon="CellPhone" />
            <NavigationViewItem Content="Android Store" Tag="store" Icon="Shop" />
            <NavigationViewItem Content="WSA Terminal" Tag="terminal">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE756;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Setup" Tag="setup" Icon="Download" />
            <NavigationViewItem Content="Runtime &amp; SDK" Tag="runtime" Icon="Library" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
