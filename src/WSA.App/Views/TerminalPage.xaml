<Page
    x:Class="WSA.App.Views.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WSA.App.ViewModels"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid Margin="{StaticResource PageMargin}" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="WSA Terminal" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Runs real Android SDK tools directly - no shell. Type help for commands." />
            </StackPanel>
            <Button Grid.Column="1" Content="Copy output" Command="{x:Bind ViewModel.CopyCommand}" />
            <Button Grid.Column="2" Content="Clear" Command="{x:Bind ViewModel.ClearCommand}" />
            <Button Grid.Column="3" Content="Cancel (Esc)" Command="{x:Bind ViewModel.CancelCommand}"
                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="4"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <ListView x:Name="OutputList" ItemsSource="{x:Bind ViewModel.Lines}" SelectionMode="None"
                      IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="8,1,8,1" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TerminalLine">
                        <TextBlock Text="{x:Bind Text}" Foreground="{x:Bind Foreground}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="13"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Prompt, Mode=OneWay}" VerticalAlignment="Center"
                       FontFamily="{StaticResource MonoFont}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBox x:Name="InputBox" Grid.Column="1" FontFamily="{StaticResource MonoFont}"
                     PlaceholderText="Enter a command, e.g. adb devices -l"
                     Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="False" IsSpellCheckEnabled="False"
                     PreviewKeyDown="InputBox_PreviewKeyDown" />
            <Button Grid.Column="2" Content="Run" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SubmitCommand}"
                    IsEnabled="{x:Bind ViewModel.IsNotRunning, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Page>
