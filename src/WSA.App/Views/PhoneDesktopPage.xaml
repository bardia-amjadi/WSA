<Page
    x:Class="WSA.App.Views.PhoneDesktopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1B2A49" Offset="0" />
                <GradientStop Color="#FF4A3F8F" Offset="0.5" />
                <GradientStop Color="#FFB5527A" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Menu bar -->
        <Grid Background="#66000000" Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Button Click="Back_Click" Padding="8,2" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Back to the Phone page (windows are closed)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" Foreground="White" />
                        <TextBlock Text="Phone" Foreground="White" FontSize="12" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" Foreground="White" FontWeight="SemiBold"
                           FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="FocusedTitle" Foreground="#CCFFFFFF" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.NetworkText, Mode=OneWay}" Foreground="White" FontSize="12" />
                <TextBlock Text="{x:Bind ViewModel.BatteryText, Mode=OneWay}" Foreground="White" FontSize="12" />
                <TextBlock Text="{x:Bind ViewModel.ClockText, Mode=OneWay}" Foreground="White" FontSize="12" />
            </StackPanel>
        </Grid>

        <!-- Desktop surface and dock -->
        <Grid Grid.Row="1">
            <Canvas x:Name="Surface" SizeChanged="Surface_SizeChanged" />
            <Border x:Name="Dock" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                    Background="#80FFFFFF" CornerRadius="18" Padding="10,8" BorderBrush="#40FFFFFF" BorderThickness="1">
                <StackPanel x:Name="DockPanel" Orientation="Horizontal" Spacing="10" />
            </Border>
        </Grid>
    </Grid>
</Page>
