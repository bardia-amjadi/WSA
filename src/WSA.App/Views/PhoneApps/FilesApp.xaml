<UserControl
    x:Class="WSA.App.Views.PhoneApps.FilesApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WSA.Core.Models"
    Loaded="UserControl_Loaded">

    <Grid Padding="10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Command="{x:Bind ViewModel.UpCommand}" ToolTipService.ToolTip="Up one folder"><FontIcon Glyph="&#xE74A;" FontSize="14" /></Button>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.GoSdcardCommand}" ToolTipService.ToolTip="Internal storage"><FontIcon Glyph="&#xE80F;" FontSize="14" /></Button>
            <TextBox Grid.Column="2" Text="{x:Bind ViewModel.PathText, Mode=TwoWay}" KeyDown="Path_KeyDown" FontFamily="{StaticResource MonoFont}" />
            <Button Grid.Column="3" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh"><FontIcon Glyph="&#xE72C;" FontSize="14" /></Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
            <Button Content="Download..." Command="{x:Bind ViewModel.DownloadCommand}" />
            <Button Content="Upload..." Command="{x:Bind ViewModel.UploadCommand}" />
            <Button Content="New folder" Command="{x:Bind ViewModel.NewFolderCommand}" />
            <Button Content="Rename" Command="{x:Bind ViewModel.RenameCommand}" />
            <Button Content="Delete" Command="{x:Bind ViewModel.DeleteCommand}" />
        </StackPanel>

        <ListView x:Name="List" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Items}"
                  SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" DoubleTapped="List_DoubleTapped"
                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DeviceFile">
                    <Grid ColumnSpacing="10" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Modified}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Spacing="6">
            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.OperationText, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}" Minimum="0" Maximum="100"
                                 Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
            </Grid>
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}" IsClosable="False" Severity="Success"
                     Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
