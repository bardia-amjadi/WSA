<UserControl
    x:Class="WSA.App.Views.PhoneApps.TerminalApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WSA.Core.Models"
    Loaded="UserControl_Loaded">

    <Grid Padding="10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#1E1E1E" CornerRadius="6" Padding="6">
            <ListView x:Name="Output" ItemsSource="{x:Bind ViewModel.Lines}" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="4,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                   Foreground="#D4D4D4" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="$" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" />
            <TextBox Grid.Column="1" x:Name="InputBox" Text="{x:Bind ViewModel.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource MonoFont}" PlaceholderText="adb shell command, e.g. getprop ro.product.model"
                     KeyDown="Input_KeyDown" />
            <Button Grid.Column="2" Content="Run" Command="{x:Bind ViewModel.ExecuteCommand}"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
        </Grid>

        <StackPanel Grid.Row="2" Spacing="6">
            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.OperationText, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}" Minimum="0" Maximum="100"
                                 Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
            </Grid>
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}" IsClosable="False" Severity="Success"
                     Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
