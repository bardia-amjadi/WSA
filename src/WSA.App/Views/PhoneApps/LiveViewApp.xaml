<UserControl
    x:Class="WSA.App.Views.PhoneApps.LiveViewApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded">

    <Grid Padding="10" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="Stage" Background="Black" CornerRadius="8">
            <MediaPlayerElement x:Name="Player" Stretch="Uniform" AreTransportControlsEnabled="False"
                                Visibility="Collapsed" />
            <Image x:Name="ShotImage" Stretch="Uniform" Visibility="Collapsed" />
            <Grid x:Name="TouchLayer" Background="Transparent"
                  PointerPressed="Touch_PointerPressed" PointerReleased="Touch_PointerReleased" />
            <Border Background="#99000000" CornerRadius="6" Padding="8,3" Margin="8"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Foreground="White"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.FpsText, Mode=OneWay}" Foreground="#7CE38B"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Column="1" Spacing="8" Width="132">
            <TextBlock Text="Controls" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.KeyCommand}" CommandParameter="BACK"
                    ToolTipService.ToolTip="Back">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="14" /><TextBlock Text="Back" /></StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.KeyCommand}" CommandParameter="HOME"
                    ToolTipService.ToolTip="Home">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE80F;" FontSize="14" /><TextBlock Text="Home" /></StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.KeyCommand}" CommandParameter="APP_SWITCH"
                    ToolTipService.ToolTip="Recent apps">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A9;" FontSize="14" /><TextBlock Text="Recents" /></StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.KeyCommand}" CommandParameter="POWER"
                    ToolTipService.ToolTip="Power / screen on-off">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7E8;" FontSize="14" /><TextBlock Text="Power" /></StackPanel>
            </Button>
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.KeyCommand}" CommandParameter="VOLUME_UP"
                        ToolTipService.ToolTip="Volume up"><FontIcon Glyph="&#xE995;" FontSize="14" /></Button>
                <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.KeyCommand}"
                        CommandParameter="VOLUME_DOWN" ToolTipService.ToolTip="Volume down"><FontIcon Glyph="&#xE993;" FontSize="14" /></Button>
            </Grid>
            <TextBox PlaceholderText="Type text..." Text="{x:Bind ViewModel.TextToSend, Mode=TwoWay}"
                     KeyDown="Text_KeyDown" />
            <Button Content="Send text" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.SendTextCommand}" />
            <Button Content="Restart stream" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.RestartCommand}" />
            <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11"
                       Text="Click = tap, drag = swipe. Frame rate and quality are in Settings." />
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
