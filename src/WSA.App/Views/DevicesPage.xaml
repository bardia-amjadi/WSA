<Page
    x:Class="WSA.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WSA.App.ViewModels"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="14" MaxWidth="1100" HorizontalAlignment="Left">

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Virtual Devices" />
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Create virtual device" Style="{StaticResource AccentButtonStyle}"
                        Click="Create_Click" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                <Button Grid.Column="2" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.OperationText, Mode=OneWay}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Cancel" Command="{x:Bind ViewModel.CancelOperationCommand}" />
                    </Grid>
                    <ProgressBar IsIndeterminate="True" />
                    <ListView ItemsSource="{x:Bind ViewModel.OperationLog}" SelectionMode="None" MaxHeight="160">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                     Title="Operation failed" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}" IsClosable="False" Severity="Success"
                     Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" />

            <Border Style="{StaticResource CardBorderStyle}" Padding="8">
                <Grid>
                    <ListView ItemsSource="{x:Bind ViewModel.Devices}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AvdRow">
                                <Grid Padding="4,8,4,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind State}" VerticalAlignment="Center"
                                               MinWidth="110" />
                                    <Button Grid.Column="2" Content="Start" IsEnabled="{x:Bind CanStart}"
                                            Click="Start_Click" />
                                    <Button Grid.Column="3" Content="Stop" IsEnabled="{x:Bind CanStop}"
                                            Click="Stop_Click" />
                                    <Button Grid.Column="4" Content="Delete" IsEnabled="{x:Bind CanStart}"
                                            Click="Delete_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="0,24,0,24"
                                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}">
                        <TextBlock Text="No virtual devices found" Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Press 'Create virtual device'. You need an installed system image; see Runtime &amp; SDK for setup steps." />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Devices reported by adb" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ConnectedDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AdbRow">
                                <Grid ColumnSpacing="12" Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Serial}" FontFamily="{StaticResource MonoFont}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind State}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Details}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Empty means adb reported no devices (or adb is unavailable; see the error above or Runtime &amp; SDK)." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
