<Page
    x:Class="WSA.App.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WSA.App.ViewModels"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="16" MaxWidth="1100" HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Setup" />
                <TextBlock Style="{StaticResource MutedTextStyle}"
                           Text="WSA installs only what your goal needs, per user and without administrator rights. Nothing is bundled; components come from their vendors." />
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Steps" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Rail, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WizardStepRow">
                                    <Grid ColumnSpacing="8" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Marker}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Number}" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Status}"
                                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="SDK folder: " /><Run Text="{x:Bind ViewModel.SdkRoot, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="14">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <ContentControl IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="14">
                            <TextBlock Text="{x:Bind ViewModel.StepTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />

                            <!-- Goal -->
                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsGoalStep, Mode=OneWay}">
                                <RadioButtons SelectedIndex="{x:Bind ViewModel.GoalIndex, Mode=TwoWay}">
                                    <RadioButton Content="Connect my phone (small download: adb only)" />
                                    <RadioButton Content="Everything: virtual Android devices, store and phone" />
                                </RadioButtons>
                                <TextBlock Text="{x:Bind ViewModel.GoalSummary, Mode=OneWay}" TextWrapping="Wrap"
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>

                            <!-- Java / command-line tools / packages / adb -->
                            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasModes, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.StepDescription, Mode=OneWay}" TextWrapping="Wrap"
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.StepStatus, Mode=OneWay}" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <RadioButtons SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}" MaxColumns="2">
                                    <RadioButton Content="Automatic" />
                                    <RadioButton Content="Manual" />
                                </RadioButtons>

                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsAutoMode, Mode=OneWay}">
                                    <Button Content="Download and install" Style="{StaticResource AccentButtonStyle}"
                                            Command="{x:Bind ViewModel.RunStepCommand}"
                                            Visibility="{x:Bind ViewModel.StepNeeded, Mode=OneWay}" />
                                    <TextBlock Text="Nothing to install for this step." Style="{StaticResource MutedTextStyle}"
                                               Visibility="{x:Bind ViewModel.IsStepDone, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsManualMode, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.ManualHelp, Mode=OneWay}" TextWrapping="Wrap"
                                               Style="{StaticResource MutedTextStyle}" />
                                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.ManualUsesJava, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{x:Bind ViewModel.ManualJavaPath, Mode=TwoWay}" PlaceholderText="C:\Java\jdk-27" />
                                        <Button Grid.Column="1" Content="Browse..." Command="{x:Bind ViewModel.BrowseCommand}" />
                                    </Grid>
                                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.ManualUsesSdk, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{x:Bind ViewModel.ManualSdkPath, Mode=TwoWay}" PlaceholderText="C:\Android\Sdk" />
                                        <Button Grid.Column="1" Content="Browse..." Command="{x:Bind ViewModel.BrowseCommand}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Use this folder" Style="{StaticResource AccentButtonStyle}"
                                                Command="{x:Bind ViewModel.ApplyManualCommand}" />
                                        <Button Content="Copy command" Command="{x:Bind ViewModel.CopyManualCommandCommand}"
                                                Visibility="{x:Bind ViewModel.HasManualCommand, Mode=OneWay}" />
                                        <Button Content="Open WSA Terminal" Command="{x:Bind ViewModel.OpenTerminalCommand}"
                                                Visibility="{x:Bind ViewModel.HasManualCommand, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Acceleration -->
                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsAccelStep, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.StepDescription, Mode=OneWay}" TextWrapping="Wrap"
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.StepStatus, Mode=OneWay}" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Open Windows Features" Command="{x:Bind ViewModel.OpenWindowsFeaturesCommand}" />
                                    <Button Content="Re-check" Command="{x:Bind ViewModel.RefreshCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Finish -->
                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsFinishStep, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.FinishSummary, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Back" Command="{x:Bind ViewModel.BackCommand}"
                                        Visibility="{x:Bind ViewModel.NotFirst, Mode=OneWay}" />
                                <Button Content="Next" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.NextCommand}"
                                        Visibility="{x:Bind ViewModel.NotLast, Mode=OneWay}" />
                                <Button Content="Finish" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.FinishCommand}"
                                        Visibility="{x:Bind ViewModel.IsLast, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                        </ContentControl>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.OperationText, Mode=OneWay}" TextWrapping="Wrap" />
                            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                                         Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                            <ListView ItemsSource="{x:Bind ViewModel.OperationLog}" SelectionMode="None" MaxHeight="160">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
                        </StackPanel>
                    </Border>

                    <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                             Title="Setup problem" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                    <InfoBar IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}" IsClosable="False" Severity="Success"
                             Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
