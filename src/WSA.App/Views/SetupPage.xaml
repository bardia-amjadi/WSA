<Page
    x:Class="WSA.App.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WSA.App.ViewModels"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="14" MaxWidth="1000" HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Setup" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Installs everything WSA needs for virtual Android devices, per user and without administrator rights. Nothing is bundled with WSA; components come from their vendors. Only want to use a real phone? Skip this and open the Phone page: it needs just adb (about 10 MB)." />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Components" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SetupStepRow">
                                <Grid ColumnSpacing="12" Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Title}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Detail}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="SDK folder: " /><Run Text="{x:Bind ViewModel.SdkRoot, Mode=OneWay}" />
                        <Run Text="  (change it in Settings)" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Install everything that is missing" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.InstallAllCommand}"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.NeedsInstall, Mode=OneWay}" />
                <Button Content="Re-check" Command="{x:Bind ViewModel.RefreshCommand}"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.OperationText, Mode=OneWay}" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                                 Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                    <ListView ItemsSource="{x:Bind ViewModel.OperationLog}" SelectionMode="None" MaxHeight="160">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                     Title="Setup problem" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}" IsClosable="False" Severity="Success"
                     Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Hardware acceleration" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.AccelerationNote, Mode=OneWay}" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="The emulator needs virtualization turned on in your BIOS/UEFI and the Windows 'Windows Hypervisor Platform' feature. WSA cannot enable these itself: Windows requires administrator approval and a restart." />
                    <Button Content="Open Windows Features" Command="{x:Bind ViewModel.OpenWindowsFeaturesCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="What gets downloaded, and from where" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Java: Microsoft Build of OpenJDK 21 from aka.ms/download-jdk (SHA-256 checked, about 200 MB, kept in %LOCALAPPDATA%\WSA\jdk). Android command-line tools: dl.google.com (SHA-1 from Google's repository index). Platform tools and emulator: installed by Google's sdkmanager. All downloads use HTTPS; the license screen shows Google's own text and nothing is accepted without your click." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
