<Page
    x:Class="WSA.App.Views.StorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WSA.App.ViewModels"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="14" MaxWidth="1100" HorizontalAlignment="Left">

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Android Store" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Android versions offered by Google for the emulator (x86_64). Each one is a large download, typically 1 to 2 GB, and needs about 6 GB free." />
                </StackPanel>
                <ComboBox Grid.Column="1" Header="Show" Width="200" SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}"
                          VerticalAlignment="Bottom">
                    <ComboBoxItem Content="All variants" />
                    <ComboBoxItem Content="Google Play" />
                    <ComboBoxItem Content="Google APIs" />
                    <ComboBoxItem Content="AOSP (no Google apps)" />
                </ComboBox>
                <Button Grid.Column="2" Content="Reload list" VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
            </Grid>

            <InfoBar IsOpen="{x:Bind ViewModel.SdkNotReady, Mode=OneWay}" IsClosable="False" Severity="Warning"
                     Title="Setup is not finished"
                     Message="The Android command-line tools are needed to read Google's catalog.">
                <InfoBar.ActionButton>
                    <Button Content="Open Setup" Click="OpenSetup_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.OperationText, Mode=OneWay}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
                    </Grid>
                    <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                                 Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                    <ListView ItemsSource="{x:Bind ViewModel.OperationLog}" SelectionMode="None" MaxHeight="140">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                     Title="Something went wrong" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}" IsClosable="False" Severity="Success"
                     Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Create virtual device" Click="CreateDevice_Click"
                            Visibility="{x:Bind ViewModel.CanCreateDevice, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border Style="{StaticResource CardBorderStyle}" Padding="8">
                <Grid>
                    <ListView ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:StoreRow">
                                <Grid Padding="4,8,4,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Variant}" />
                                        <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Install" IsEnabled="{x:Bind CanInstall}"
                                            Style="{StaticResource AccentButtonStyle}" Click="Install_Click" />
                                    <Button Grid.Column="3" Content="Remove" IsEnabled="{x:Bind CanRemove}"
                                            Click="Remove_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel HorizontalAlignment="Center" Margin="0,24,0,24" Spacing="6"
                                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}">
                        <TextBlock Text="Nothing to show" Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Google's catalog returned no matching images for this filter. Try 'All variants' or Reload list." />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
