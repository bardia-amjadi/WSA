<Page
    x:Class="WSA.App.Views.RuntimePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WSA.App.ViewModels"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="16" MaxWidth="1100" HorizontalAlignment="Left">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Runtime &amp; SDK" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="WSA manages the official Android Emulator; it does not bundle the SDK." />
                </StackPanel>
                <ProgressRing Grid.Column="1" Width="22" Height="22" VerticalAlignment="Center"
                              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <Button Grid.Column="2" Content="Open SDK folder" Command="{x:Bind ViewModel.OpenSdkFolderCommand}" />
                <Button Grid.Column="3" Content="Re-detect" Command="{x:Bind ViewModel.RefreshCommand}"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
            </Grid>

            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                     Title="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="SDK root" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SdkRoot, Mode=OneWay}" IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.SdkSource, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Tools" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Tools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ToolRow">
                                <StackPanel Spacing="2" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource MonoFont}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind State}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Location}" IsTextSelectionEnabled="True"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Version}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Problem}" TextWrapping="Wrap"
                                               Visibility="{x:Bind HasProblem}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Diagnostics" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Diagnostics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,2,0,2"
                                           IsTextSelectionEnabled="True" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Manual setup steps" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SetupGuide}" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
